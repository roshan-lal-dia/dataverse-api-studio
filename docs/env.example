# Dataverse Web API Studio - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the real .env file to version control!

# Azure Entra ID Tenant ID (found in Azure Portal)
# Format: 00000000-0000-0000-0000-000000000000
TENANT_ID=

# App Registration Client ID
# Register app: Azure Portal → Azure Active Directory → App registrations
CLIENT_ID=

# App Registration Client Secret
# Create in: App registrations → Certificates & secrets → New client secret
# ⚠️ NEVER share or commit this value!
CLIENT_SECRET=

# Dataverse Organization URLs by Environment
# Format: https://your-org.crm.dynamics.com
# Find it: Power Apps (https://make.powerapps.com) → Settings → About
# Add as many environments as needed. The app will auto-detect them.
# Environment names are extracted from the suffix (e.g., ORG_URL_DEV → DEV)

# Production Environment
ORG_URL_PROD=

# Development Environment
ORG_URL_DEV=

# Optional: Add more environments
# ORG_URL_SANDBOX=
# ORG_URL_UAT=
# ORG_URL_TEST=

# Optional: Default table for quick operations
DEFAULT_TABLE=account

# Optional: Default top limit for queries
DEFAULT_TOP=100

# Optional: Enable debug logging
DEBUG=false
